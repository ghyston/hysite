<!DOCTYPE html>
@{
    var themeCookie = Context.Request.Cookies[HySite.Application.Helpers.ThemePreferenceHelper.CookieName];
    var theme = HySite.Application.Helpers.ThemePreferenceHelper.ResolveTheme(themeCookie);
    var themeClass = HySite.Application.Helpers.ThemePreferenceHelper.GetThemeClass(theme);
    var nextTheme = HySite.Application.Helpers.ThemePreferenceHelper.GetNextTheme(theme);
    var themeIconClass = HySite.Application.Helpers.ThemePreferenceHelper.GetThemeIconClass(theme);
}
<html class="@themeClass">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - hySite</title>
    <link rel="stylesheet" type="text/css" href="/css/retro.css">
    <link rel="stylesheet" type="text/css" href="/css/hyston.blog.css">
    <link href="https://mastodon.social/@@hyston" rel="me">
</head>
<body>
    <form class="themeToggle" method="post" action="/theme/toggle">
        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
        <button class="themeToggleButton" type="submit" name="theme" value="@nextTheme" aria-label="Current theme: @theme. Switch to @nextTheme">
            <span class="themeToggleIcon @themeIconClass" aria-hidden="true"></span>
        </button>
    </form>
    <div style="width: 100%; text-align: center">
        <a class="blogTitle" href="/">Hyston blog</a>
        <br/>
        <a class="blogTitleItem" href="/About">About</a>&nbsp;•&nbsp;<a class="blogTitleItem" href="/Archive">Archive</a>&nbsp;•&nbsp;<a class="blogTitleItem" href="/rss">RSS</a>
    </div>
    <hr/>
    @RenderBody()
</body>
</html>
